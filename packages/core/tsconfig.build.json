{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  "exclude": [
    "src/**/*.test.ts",
    "src/**/__tests__/**",
    "src/test-utils/**"
  ],
  "include": ["src"]
}
