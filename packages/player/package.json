{
  "name": "@zeffuro/zerith-player",
  "version": "0.1.0",
  "description": "Static web player and export CLI for Zerith visual novel projects.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Zeffuro/Zerith.git",
    "directory": "packages/player"
  },
  "type": "module",
  "bin": {
    "zerith-player": "scripts/build-game.mjs"
  },
  "files": [
    "index.html",
    "scripts/build-game.mjs",
    "scripts/content-compiler.mjs",
    "src/main.ts",
    "vite.config.ts",
    "LICENSE",
    "README.md",
    "src/runtime/*.ts",
    "src/runtime/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run build --workspace=@zeffuro/zerith-core",
    "build": "tsc && vite build",
    "prebuild:game": "npm run build --workspace=@zeffuro/zerith-core",
    "build:game": "node ./scripts/build-game.mjs",
    "prebuild:game:zip": "npm run build --workspace=@zeffuro/zerith-core",
    "build:game:zip": "node ./scripts/build-game.mjs --zip",
    "export:parity-smoke": "node ./scripts/export-parity-smoke.mjs",
    "preview": "vite preview",
    "test:runtime-smoke": "node ./scripts/exported-runtime-smoke.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "vite": "^8.3.2",
    "@zeffuro/zerith-core": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3"
  }
}
