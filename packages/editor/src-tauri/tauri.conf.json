{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zerith Editor",
  "version": "0.1.3",
  "identifier": "com.zeffuro.zerith.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zerith Editor",
        "width": 1280,
        "height": 720,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlEMENEQzg1OTZEMUFFQUQKUldTdHJ0R1doZHdNblRmQ1hmY1Y4U3FydmQwSHFFb0t3d1drWkRLS3FGTFhhQ1JOdTIvVlp6dFgK",
      "endpoints": [
        "https://github.com/Zeffuro/Zerith/releases/latest/download/latest.json"
      ]
    }
  }
}
