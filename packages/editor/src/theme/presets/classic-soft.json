{
  "key": "classicSoft",
  "label": "Classic Soft",
  "vars": {
    "--editor-bg-app": "#1f2022",
    "--editor-bg-panel": "#282a2d",
    "--editor-bg-panel-alt": "#313338",
    "--editor-bg-input": "#1f2022",
    "--editor-bg-popup": "#232529",
    "--editor-bg-hover": "#32353a",
    "--editor-bg-selected": "#0a446a",
    "--editor-bg-danger": "#7f2b2b",
    "--editor-bg-preview": "#000",

    "--editor-border-subtle": "#3a3d42",
