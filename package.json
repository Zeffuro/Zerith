{
  "name": "zerith",
  "description": "TypeScript visual novel engine, desktop editor, and static player export pipeline.",
  "private": true,
  "license": "MIT",
  "keywords": [
    "game-engine",
    "interactive-fiction",
    "react",
    "tauri",
    "typescript",
    "visual-novel"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Zeffuro/Zerith.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "brace-expansion": "5.0.6",
    "flatted": "3.4.2",
    "monaco-editor": {
      "dompurify": "3.4.10"
    }
  },
  "scripts": {
    "dev:player": "npm run dev --workspace=zerith-player",
    "dev:editor": "npm run tauri dev --workspace=zerith-editor",
    "build:game": "npm run build:game --workspace=zerith-player --",
    "build:game:zip": "npm run build:game:zip --workspace=zerith-player --",
    "export:parity-smoke": "npm run export:parity-smoke --workspace=zerith-player --",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint \"packages/**/*.{ts,tsx}\" --max-warnings 0",
    "lint:fix": "eslint \"packages/**/*.{ts,tsx}\" --max-warnings 0 --fix",
    "report:editor-artifacts": "node scripts/report-editor-artifacts.mjs",
    "report:editor-distribution": "node scripts/report-editor-distribution-readiness.mjs",
    "report:editor-published-release": "node scripts/report-editor-published-release.mjs",
    "report:editor-updater": "node scripts/report-editor-updater-readiness.mjs",
    "report:npm-publication": "node scripts/report-npm-publication-readiness.mjs",
    "report:package-publication": "node scripts/report-package-publication-readiness.mjs",
    "report:release-readiness": "node scripts/report-release-readiness.mjs",
    "report:version-policy": "node scripts/report-version-policy.mjs",
    "test": "vitest run",
    "test:fixture-policy": "node scripts/guard-safe-fixtures.mjs",
    "test:npm-core": "node scripts/smoke-npm-package.mjs zerith-core",
    "test:public-readiness": "node scripts/check-public-readiness.mjs",
    "test:runtime-smoke": "npm run test:runtime-smoke --workspace=zerith-player --",
    "test:visual": "playwright test -c playwright.config.mjs",
    "test:visual:ci": "playwright test -c playwright.config.mjs --grep-invert \"captures\"",
    "test:visual:update": "playwright test -c playwright.config.mjs --update-snapshots",
    "version:editor": "node scripts/bump-editor-version.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "eslint": "^10.5.0",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^65.0.1",
    "globals": "^17.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  }
}
