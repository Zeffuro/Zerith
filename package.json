{
  "name": "zerith",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "brace-expansion": "5.0.6",
    "flatted": "3.4.2",
    "monaco-editor": {
      "dompurify": "3.4.10"
    }
  },
  "scripts": {
    "dev:player": "npm run dev --workspace=player",
    "dev:editor": "npm run tauri dev --workspace=editor",
    "build:game": "npm run build:game --workspace=player --",
    "build:game:zip": "npm run build:game:zip --workspace=player --",
    "export:parity-smoke": "npm run export:parity-smoke --workspace=player --",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint \"packages/**/*.{ts,tsx}\" --max-warnings 0",
    "lint:fix": "eslint \"packages/**/*.{ts,tsx}\" --max-warnings 0 --fix",
    "test": "vitest run",
    "test:fixture-policy": "node scripts/guard-safe-fixtures.mjs",
    "test:runtime-smoke": "npm run test:runtime-smoke --workspace=player --",
    "test:visual": "playwright test -c playwright.config.mjs",
    "test:visual:ci": "playwright test -c playwright.config.mjs --grep-invert \"captures\"",
    "test:visual:update": "playwright test -c playwright.config.mjs --update-snapshots"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "eslint": "^10.5.0",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^65.0.1",
    "globals": "^17.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  }
}
