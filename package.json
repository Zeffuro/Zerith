{
  "name": "zerith",
  "description": "TypeScript visual novel engine, desktop editor, and static player export pipeline.",
  "private": true,
  "license": "MIT",
  "keywords": [
    "game-engine",
    "interactive-fiction",
    "react",
    "tauri",
    "typescript",
    "visual-novel"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Zeffuro/Zerith.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "brace-expansion": "5.0.12",
    "flatted": "3.4.2",
    "monaco-editor": {
      "dompurify": "3.4.16"
    }
  },
  "scripts": {
    "dev:player": "npm run dev --workspace=@zeffuro/zerith-player",
    "dev:editor": "npm run tauri dev --workspace=zerith-editor",
    "dev:editor:web": "npm run dev --workspace=zerith-editor -- --host 127.0.0.1 --open",
    "build:game": "npm run build:game --workspace=@zeffuro/zerith-player --",
    "build:game:zip": "npm run build:game:zip --workspace=@zeffuro/zerith-player --",
    "build:game:desktop": "npm run build --workspace=@zeffuro/zerith-core && node packages/player/scripts/build-desktop-game.mjs",
    "build:player:desktop": "node packages/player/scripts/build-desktop-runtime.mjs",
    "export:parity-smoke": "npm run export:parity-smoke --workspace=@zeffuro/zerith-player --",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run release:check",
    "lint": "eslint \"packages/**/*.{ts,tsx}\" --max-warnings 0",
    "lint:fix": "eslint \"packages/**/*.{ts,tsx}\" --max-warnings 0 --fix",
    "check:public": "node scripts/check-public-surface.mjs",
    "release:check": "node scripts/check-release.mjs",
    "release:verify": "node scripts/report-editor-published-release.mjs",
    "pretest": "npm run build --workspace=@zeffuro/zerith-core",
    "test": "vitest run",
    "test:fixture-policy": "node scripts/guard-safe-fixtures.mjs",
    "test:publication": "node --test scripts/package-publication.test.mjs",
    "test:npm-core": "node scripts/smoke-npm-package.mjs @zeffuro/zerith-core",
    "test:npm-player": "node scripts/smoke-npm-package.mjs @zeffuro/zerith-player",
    "test:runtime-smoke": "npm run test:runtime-smoke --workspace=@zeffuro/zerith-player --",
    "test:desktop-package": "node --test packages/player/scripts/desktop-package.test.mjs",
    "test:desktop-runtime": "pwsh -NoProfile -File scripts/smoke-desktop-game.ps1",
    "test:native-profiles": "pwsh -NoProfile -File scripts/test-native-test-profiles.ps1",
    "test:installed-editor": "pwsh -NoProfile -File scripts/smoke-installed-editor.ps1",
    "test:visual": "playwright test -c playwright.config.mjs",
    "test:visual:profiles": "node --test scripts/test-browser-profiles.test.mjs",
    "test:visual:ci": "playwright test -c playwright.config.mjs --grep-invert \"captures\"",
    "test:editing": "playwright test -c playwright.config.mjs --grep \"sustained multi-tab\"",
    "test:visual:update": "playwright test -c playwright.config.mjs --update-snapshots",
    "version:editor": "node scripts/bump-editor-version.mjs",
    "version:npm": "node scripts/bump-npm-package-versions.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^65.0.1",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
