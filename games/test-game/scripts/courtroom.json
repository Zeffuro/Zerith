            "lineId": "scene.courtroom.line.004"
        },
        {
            "key": "attorney_badge",
            "source": "items",
            "type": "if",
            "onTrue": [],
            "onFalse": []
        },
        {
            "speaker": "judge",
            "text": "Very well. The autopsy report has been submitted into evidence.",
            "type": "dialogue",
            "lineId": "scene.courtroom.line.006"
        },
        {
            "action": "add",
