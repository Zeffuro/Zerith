        {
            "name": "interrogation_start",
            "type": "label"
        },
        {
            "action": "pose",
            "id": "phoenix",
            "pose": "thinking",
            "type": "sprite"
        },
        {
            "speaker": "phoenix",
            "text": "Tell me what happened.",
            "type": "dialogue",
            "lineId": "scene.courtroom.line.010"
        },
        {
            "action": "animate",
            "animation": "idle_blink",
            "id": "phoenix",
            "type": "sprite"
        },
        {
            "speaker": "Witness",
