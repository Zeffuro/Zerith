                    "labelId": "scene.courtroom.choice.013.option.002.label"
                }
            ],
            "type": "choice",
            "id": "scene.courtroom.choice.013"
        },
        {
            "speaker": "judge",
            "text": "Dear Phoenix, I regret to inform you...{wait:1000}\nYou are truly {wait:500}<b>{color='red'}AN IDIOT{/color}</b>",
            "type": "dialogue",
