                },
                {
                    "commands": [
                        {
                            "key": "ending_tone",
                            "type": "set",
                            "value": "bright"
                        },
                        {
                            "to": "ending",
                            "type": "jump"
                        }
                    ],
                    "id": "chapter_one.tone_choice.bright",
                    "label": "Make the ending bright",
                    "labelId": "chapter_one.tone_choice.bright.label"
